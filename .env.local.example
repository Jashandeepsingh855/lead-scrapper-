# Comma-separated list of Apify API keys for rotation
APIFY_KEYS=apify_api_key1,apify_api_key2,apify_api_key3
# Single Apify API Token fallback
APIFY_API_TOKEN=your_apify_api_token_here
# Google Apps Script Web App URL for multi-city lead syncing
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
